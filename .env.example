# Neon: use the POOLED connection string (host contains "-pooler")
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Admin auth (single admin). Generate hash with: npm run hash -- "your-password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
JWT_SECRET=

# Brevo (https://app.brevo.com -> SMTP & API -> API keys)
BREVO_API_KEY=
# Must be a verified sender in Brevo
BREVO_SENDER_EMAIL=
CONTACT_TO_EMAIL=you@example.com

# Vercel Blob (Vercel dashboard -> Storage -> Blob -> create store; token is auto-added on Vercel)
BLOB_READ_WRITE_TOKEN=

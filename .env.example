# Admin login (required for /admin)
ADMIN_PASSWORD=choose-a-long-passphrase
AUTH_SECRET=run: openssl rand -hex 32
# Content storage. Leave empty locally (uses data/content.json). Required on Vercel.
DATABASE_URL=
# Contact form via Brevo
BREVO_API_KEY=
CONTACT_FROM=verified-sender@yourdomain.com
CONTACT_TO=you@example.com
